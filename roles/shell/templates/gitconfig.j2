# Managed by Ansible (roles/shell). Your name/email go in ~/.gitconfig, which this doesn't touch:
#   git config --global user.name "..."; git config --global user.email "..."
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[diff]
	colorMoved = default
[merge]
	conflictstyle = zdiff3
{% if 'delta' in cli_tools %}
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
{% endif %}
